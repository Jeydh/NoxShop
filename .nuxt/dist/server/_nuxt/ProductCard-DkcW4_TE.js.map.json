{"file":"ProductCard-DkcW4_TE.js","mappings":";;;;;;;;;;AA+Fa,iBAAA;AACb,UAAM,EAAE,YAAA,IAAgB,YAAA;AAExB,UAAM,WAAW,IAAI,KAAK;;;AAhGtB,YAAA,WAAAA,eAAAC,WAAA,EAAA,OAAM,kOAA8N,MAAA,CAAA,CAAA,GAAA;;QAIjO,IAAE,aAAe,QAAA,QAAQ,IAAI;AAAA,QAC9B,OAAM;AAAA,MAAA;yBAFR,CA8BW,GAAAC,QAAAC,UAAA,aAAA;;oHAxBJ,OAAK,QAAA,QAAQ,KAAK,kBAClB,OAAK,QAAA,QAAQ,IAAI;AAMZ,gBAAA,QAAA,QAAQ,SAAK,GAAA;;;;;AAWb,gBAAA,QAAA,QAAQ,YAAY,QAAA,QAAQ,QAAK,GAAA;;;;;;;;cApB3CC,YAyBM,OAAA,EAzBD,OAAM,yDAAqD;AAAA,gBAC9DA,YAKC,OAAA;AAAA,kBAJE,KAAK,QAAA,QAAQ;AAAA,kBACb,KAAK,QAAA,QAAQ;AAAA,kBACd,SAAQ;AAAA,kBACR,OAAM;AAAA,gBAAA;gBAIA,QAAA,QAAQ,SAAK,kBADrBC,YASM,OAAA;AAAA;kBAPJ,OAAM;AAAA,gBAAA;kBAEND,YAIO,QAAA,EAHL,OAAM,kGAAA,GACP,gBAED;AAAA,gBAAA;gBAIM,QAAA,QAAQ,YAAY,QAAA,QAAQ,QAAK,kBADzCC,YAKO,QAAA;AAAA;kBAHL,OAAM;AAAA,gBAAA,GACP,aAED;;;;;;;;;QAOC,IAAE,aAAe,QAAA,QAAQ,IAAI;AAAA,QAC9B,OAAM;AAAA,MAAA;yBAFR,CAWW,GAAAH,QAAAC,UAAA,aAAA;;uIANJG,eAAA,QAAA,QAAQ,IAAI,mFAIZC,MAAA,WAAA,EAAY,QAAA,QAAQ,KAAK,CAAA;;;cAL9BH,YAEK,QAFD,OAAM,4FAAA,GAA2FI,gBAChG,QAAA,QAAQ,IAAI,GAAA,CAAA;AAAA,cAGjBJ,YAEI,KAAA,EAFD,OAAM,0DACJG,MAAA,WAAA,EAAY,QAAA,QAAQ,KAAK,CAAA,GAAA,CAAA;AAAA,YAAA;AAAA;;;;0DAOnB,QAAA,QAAQ,SAAK,KAAS,SAAA,KAAQ,IAAA,cAAA,EAAA,wSAAA;UAI7B,SAAA,OAAQ;;MAIH,WAAA,QAAA,QAAQ,SAAK,GAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_createVNode","_createBlock","_ssrInterpolate","_unref","_toDisplayString"],"sources":["../../../../components/ProductCard.vue"],"sourcesContent":["<template>\n  <article\n    class=\"group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] transition duration-300 hover:-translate-y-1 hover:border-violet-400/30 hover:bg-white/[0.055] hover:shadow-xl hover:shadow-violet-950/20\"\n  >\n    <!-- Image -->\n    <NuxtLink\n      :to=\"`/products/${product.slug}`\"\n      class=\"block\"\n    >\n      <div class=\"relative aspect-square overflow-hidden bg-slate-800\">\n        <img\n          :src=\"product.image\"\n          :alt=\"product.name\"\n          loading=\"lazy\"\n          class=\"h-full w-full object-cover transition duration-500 group-hover:scale-105\"\n        >\n\n        <div\n          v-if=\"product.stock <= 0\"\n          class=\"absolute inset-0 flex items-center justify-center bg-slate-950/65 backdrop-blur-[2px]\"\n        >\n          <span\n            class=\"rounded-full border border-red-400/20 bg-red-400/10 px-3 py-1.5 text-xs font-black text-red-300\"\n          >\n            Indisponible\n          </span>\n        </div>\n\n        <span\n          v-if=\"product.featured && product.stock > 0\"\n          class=\"absolute left-3 top-3 rounded-full bg-violet-500 px-2.5 py-1 text-[10px] font-black text-white shadow-lg shadow-violet-500/30\"\n        >\n          POPULAIRE\n        </span>\n      </div>\n    </NuxtLink>\n\n    <!-- Informations -->\n    <div class=\"p-3\">\n      <NuxtLink\n        :to=\"`/products/${product.slug}`\"\n        class=\"block\"\n      >\n        <h3 class=\"line-clamp-2 min-h-10 text-sm font-bold text-white transition group-hover:text-violet-300\">\n          {{ product.name }}\n        </h3>\n\n        <p class=\"mt-1 text-base font-black text-white\">\n          {{ formatPrice(product.price) }}\n        </p>\n      </NuxtLink>\n\n      <!-- Ajout panier -->\n      <button\n        type=\"button\"\n        :disabled=\"product.stock <= 0 || isAdding\"\n        class=\"mt-3 flex w-full items-center justify-center gap-2 rounded-xl bg-white/10 px-3 py-2.5 text-xs font-black text-white transition hover:bg-violet-500 hover:shadow-lg hover:shadow-violet-500/20 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-white/10\"\n        @click=\"addToCart\"\n      >\n        <span v-if=\"isAdding\">\n          ✓ Ajouté\n        </span>\n\n        <span v-else-if=\"product.stock <= 0\">\n          Rupture\n        </span>\n\n        <span v-else>\n          + Ajouter\n        </span>\n      </button>\n    </div>\n  </article>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\n\nimport { useCartStore } from '~/stores/useCart'\nimport { useCurrency } from '~/composables/useCurrency'\n\ninterface Product {\n  id: string\n  name: string\n  slug: string\n  image: string\n  price: number\n  stock: number\n  featured?: boolean\n}\n\nconst props = defineProps<{\n  product: Product\n}>()\n\nconst cart = useCartStore()\nconst { formatPrice } = useCurrency()\n\nconst isAdding = ref(false)\n\nfunction addToCart() {\n  if (props.product.stock <= 0 || isAdding.value) {\n    return\n  }\n\n  const added = cart.add(props.product.id)\n\n  if (!added) {\n    return\n  }\n\n  isAdding.value = true\n\n  window.setTimeout(() => {\n    isAdding.value = false\n  }, 650)\n}\n</script>"],"version":3}