{"file":"_slug_-BjrYEH62.js","mappings":";;;;;;;;;;;;;;;;;;;AAoGA,UAAM,QAAQ,SAAA;AAEd,UAAM,UAAU,gBAAA;AACH,iBAAA;AAEb,UAAM,EAAE,YAAA,IAAgB,YAAA;AAExB,UAAM,UAAU,SAAS,MAAM;AAC7B,aAAO,QAAQ,SAAS;AAAA,QACtB,CAAC,SAAS,KAAK,SAAS,MAAM,OAAO;AAAA,MAAA;AAAA,IAEzC,CAAC;AAUD,eAAW;AAAA,MACT,OAAO,MAAM,QAAQ,QACjB,GAAG,QAAQ,MAAM,IAAI,WACrB;AAAA,MAEJ,aAAa,MAAM,QAAQ,OAAO,eAAe;AAAA,IAAA,CAClD;;;UA7HS,QAAA,OAAO;AACb,cAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,gEAA4D,MAAA,CAAA,CAAA,GAAA;;UAGhE,IAAG;AAAA,UACH,OAAM;AAAA,QAAA;2BAFR,CAKW,GAAAC,QAAAC,UAAA,aAAA;;;;;gCAFV,yBAED;AAAA,cAAA;AAAA;;;;0MASS,OAAK,QAAA,MAAQ,KAAK,kBAClB,OAAK,QAAA,MAAQ,IAAI;AASd,YAAA,QAAA,MAAQ,UAAQ;;;;;6EAOnBC,eAAA,QAAA,MAAQ,IAAI,uEAIZC,MAAA,WAAA,EAAY,QAAA,MAAQ,KAAK,CAAA,iDAIzBD,eAAA,QAAA,MAAQ,WAAW;AAIhB,YAAA,QAAA,MAAQ,QAAK,GAAA;;;;;sCAgBRE,sBAAA,QAAA,MAAQ,SAAK,CAAA,IAAA,cAAA,6LAIrBF,eAAA,QAAA,MAAQ,QAAK,IAAA,sBAAA,cAAA;;AAQtB,cAAA,OAAAJ,eAAAC,WAAA,EAAA,OAAM,8CAA0C,MAAA,CAAA,CAAA,wEAAA;;UAO9C,IAAG;AAAA,UACH,OAAM;AAAA,QAAA;2BAFR,CAKW,GAAAC,QAAAC,UAAA,aAAA;;;;;gCAFV,uBAED;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_ssrInterpolate","_unref","_ssrIncludeBooleanAttr"],"sources":["../../../../pages/categories/[slug].vue"],"sourcesContent":["<template>\n  <div\n    v-if=\"product\"\n    class=\"mx-auto max-w-6xl px-4 py-8 pb-28 sm:px-6 lg:px-8 lg:py-14\"\n  >\n    <NuxtLink\n      to=\"/products\"\n      class=\"text-sm font-medium text-slate-400 transition hover:text-white\"\n    >\n      ← Retour aux produits\n    </NuxtLink>\n\n    <div class=\"mt-8 grid gap-8 lg:grid-cols-2 lg:items-center\">\n      <!-- Image -->\n      <div\n        class=\"overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03]\"\n      >\n        <div class=\"aspect-square\">\n          <img\n            :src=\"product.image\"\n            :alt=\"product.name\"\n            class=\"h-full w-full object-cover\"\n          >\n        </div>\n      </div>\n\n      <!-- Infos -->\n      <div>\n        <span\n          v-if=\"product.featured\"\n          class=\"inline-flex rounded-full bg-violet-500/10 px-3 py-1 text-xs font-black text-violet-400\"\n        >\n          Produit populaire\n        </span>\n\n        <h1 class=\"mt-4 text-3xl font-black text-white sm:text-5xl\">\n          {{ product.name }}\n        </h1>\n\n        <p class=\"mt-4 text-3xl font-black text-white\">\n          {{ formatPrice(product.price) }}\n        </p>\n\n        <p class=\"mt-6 leading-7 text-slate-400\">\n          {{ product.description }}\n        </p>\n\n        <div\n          v-if=\"product.stock > 0\"\n          class=\"mt-6 flex items-center gap-2 text-sm font-bold text-emerald-400\"\n        >\n          <span class=\"h-2 w-2 rounded-full bg-emerald-400\" />\n          Disponible en magasin\n        </div>\n\n        <div\n          v-else\n          class=\"mt-6 rounded-2xl border border-red-400/10 bg-red-400/5 p-4 text-sm font-bold text-red-300\"\n        >\n          Ce produit est actuellement indisponible.\n        </div>\n\n        <button\n          type=\"button\"\n          :disabled=\"product.stock <= 0\"\n          class=\"mt-8 w-full rounded-2xl bg-white px-5 py-4 text-sm font-black text-slate-950 transition hover:scale-[1.01] active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40\"\n          @click=\"addToCart\"\n        >\n          {{ product.stock > 0 ? 'Ajouter au panier' : 'Indisponible' }}\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <div\n    v-else\n    class=\"mx-auto max-w-3xl px-4 py-20 text-center\"\n  >\n    <h1 class=\"text-2xl font-black text-white\">\n      Produit introuvable\n    </h1>\n\n    <NuxtLink\n      to=\"/products\"\n      class=\"mt-5 inline-block text-violet-400\"\n    >\n      Retour au catalogue\n    </NuxtLink>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\n\nimport { useRoute } from 'vue-router'\n\nimport { useCatalogStore } from '~/stores/useCatalog'\nimport { useCartStore } from '~/stores/useCart'\nimport { useCurrency } from '~/composables/useCurrency'\n\nconst route = useRoute()\n\nconst catalog = useCatalogStore()\nconst cart = useCartStore()\n\nconst { formatPrice } = useCurrency()\n\nconst product = computed(() => {\n  return catalog.products.find(\n    (item) => item.slug === route.params.slug\n  )\n})\n\nfunction addToCart() {\n  if (!product.value) {\n    return\n  }\n\n  cart.add(product.value.id)\n}\n\nuseSeoMeta({\n  title: () => product.value\n    ? `${product.value.name} — Nox`\n    : 'Produit introuvable — Nox',\n\n  description: () => product.value?.description ?? ''\n})\n</script>"],"version":3}