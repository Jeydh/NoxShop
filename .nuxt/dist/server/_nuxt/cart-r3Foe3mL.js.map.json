{"file":"cart-r3Foe3mL.js","mappings":";;;;;;;;;;;;;;;;;AAsNA,UAAM,OAAO,aAAA;AACb,UAAM,UAAU,gBAAA;AAEhB,UAAM,EAAE,YAAA,IAAgB,YAAA;AAExB,UAAM,YAAY,SAAS,MAAM;AAC/B,aAAO,OAAO,QAAQ,KAAK,KAAK,EAC7B,IAAI,CAAC,CAAC,IAAI,QAAQ,MAAM;AACvB,cAAM,UAAU,QAAQ,SAAS;AAAA,UAC/B,CAAC,SAAS,KAAK,OAAO;AAAA,QAAA;AAGxB,YAAI,CAAC,SAAS;AACZ,iBAAO;AAAA,QACT;AAEA,eAAO;AAAA,UACL;AAAA,UACA;AAAA,QAAA;AAAA,MAEJ,CAAC,EACA;AAAA,QACC,CACE,SAIG,SAAS;AAAA,MAAA;AAAA,IAEpB,CAAC;;;AAlPM,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,uDAAmD,MAAA,CAAA,CAAA,GAAA;;QAE1D,IAAG;AAAA,QACH,OAAM;AAAA,MAAA;yBAFR,CAKW,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAFV,0BAED;AAAA,YAAA;AAAA;;;;;AAcQ,UAAA,UAAA,MAAU,WAAM,GAAA;;;UAgBpB,IAAG;AAAA,UACH,OAAM;AAAA,QAAA;2BAFR,CAKW,GAAAD,QAAAC,UAAA,aAAA;;;;;gCAFV,qBAED;AAAA,cAAA;AAAA;;;;;;;AAcqBC,sBAAA,UAAA,QAAR,SAAI;;;YAMR,IAAE,aAAe,KAAK,QAAQ,IAAI;AAAA,YACnC,OAAM;AAAA,UAAA;6BAFR,CASW,GAAAF,QAAAC,UAAA,aAAA;;8BAJNE,cAAA,OAAK,KAAK,QAAQ,KAAK,IACvBA,cAAA,OAAK,KAAK,QAAQ,IAAI;;;kBAFzBC,YAIC,OAAA;AAAA,oBAHE,KAAK,KAAK,QAAQ;AAAA,oBAClB,KAAK,KAAK,QAAQ;AAAA,oBACnB,OAAM;AAAA,kBAAA;;;;;;;;YASD,IAAE,aAAe,KAAK,QAAQ,IAAI;AAAA,YACnC,OAAM;AAAA,UAAA;6BAFR,CAKW,GAAAJ,QAAAC,UAAA,aAAA;;yCADN,KAAK,QAAQ,IAAI,CAAA,EAAA;AAAA;;kDAAjB,KAAK,QAAQ,IAAI,GAAA,CAAA;AAAA,gBAAA;AAAA;;;;0DAIjBI,eAAAC,MAAA,WAAA,EAAY,KAAK,QAAQ,KAAK,CAAA,gfA8B9BD,eAAA,KAAK,QAAQ,4KAMLE,sBAAA,KAAK,YAAY,KAAK,QAAQ,KAAK,IAAA,cAAA,kGAU9CD,MAAA,WAAA;AAAA,YAAmC,KAAK,QAAQ,QAAQ,KAAK;AAAA,UAAA;;wZA+BhED,eAAAC,MAAA,IAAA,EAAK,KAAK,KACVD,eAAAC,MAAA,IAAA,EAAK,QAAK,IAAA,aAAA,SAAA,mDAIVA,MAAA,WAAA,EAAYA,MAAA,IAAA,EAAK,QAAQ,CAAA,kYAuB3BA,MAAA,WAAA,EAAYA,MAAA,IAAA,EAAK,QAAQ,CAAA;;UAK9B,IAAG;AAAA,UACH,OAAM;AAAA,QAAA;2BAFR,CAKW,GAAAN,QAAAC,UAAA,aAAA;;;;;gCAFV,wBAED;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_ssrRenderList","_ssrRenderAttr","_createVNode","_ssrInterpolate","_unref","_ssrIncludeBooleanAttr"],"sources":["../../../../pages/cart.vue"],"sourcesContent":["<template>\n  <div class=\"mx-auto max-w-5xl px-4 py-8 pb-20 sm:px-6 lg:px-8\">\n    <NuxtLink\n      to=\"/products\"\n      class=\"inline-flex items-center gap-2 text-sm font-medium text-slate-400 transition hover:text-white\"\n    >\n      ← Continuer mes achats\n    </NuxtLink>\n\n    <div class=\"mt-6\">\n      <p class=\"text-sm font-bold uppercase tracking-wider text-violet-400\">\n        Commande\n      </p>\n\n      <h1 class=\"mt-1 text-3xl font-black text-white sm:text-4xl\">\n        Votre panier\n      </h1>\n    </div>\n\n    <!-- Panier vide -->\n    <div\n      v-if=\"cartLines.length === 0\"\n      class=\"mt-10 rounded-3xl border border-white/10 bg-white/[0.03] px-6 py-16 text-center\"\n    >\n      <div class=\"text-5xl\">\n        🛒\n      </div>\n\n      <h2 class=\"mt-5 text-xl font-black text-white\">\n        Votre panier est vide\n      </h2>\n\n      <p class=\"mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-400\">\n        Ajoutez quelques produits et votre commande apparaîtra ici.\n      </p>\n\n      <NuxtLink\n        to=\"/products\"\n        class=\"mt-6 inline-flex rounded-xl bg-white px-5 py-3 text-sm font-black text-slate-950 transition hover:scale-[1.02] active:scale-[0.98]\"\n      >\n        Voir les produits\n      </NuxtLink>\n    </div>\n\n    <!-- Panier -->\n    <div\n      v-else\n      class=\"mt-8 grid gap-6 lg:grid-cols-[1fr_340px]\"\n    >\n      <!-- Produits -->\n      <section class=\"space-y-3\">\n        <div\n          class=\"space-y-3\"\n        >\n          <article\n            v-for=\"item in cartLines\"\n            :key=\"item.product.id\"\n            class=\"flex gap-3 rounded-2xl border border-white/10 bg-white/[0.035] p-3 sm:gap-4 sm:p-4\"\n          >\n            <!-- Image -->\n            <NuxtLink\n              :to=\"`/products/${item.product.slug}`\"\n              class=\"h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-slate-800 sm:h-28 sm:w-28\"\n            >\n              <img\n                :src=\"item.product.image\"\n                :alt=\"item.product.name\"\n                class=\"h-full w-full object-cover transition duration-300 hover:scale-105\"\n              >\n            </NuxtLink>\n\n            <!-- Informations -->\n            <div class=\"min-w-0 flex-1\">\n              <div class=\"flex items-start justify-between gap-3\">\n                <div class=\"min-w-0\">\n                  <NuxtLink\n                    :to=\"`/products/${item.product.slug}`\"\n                    class=\"line-clamp-2 text-sm font-bold text-white transition hover:text-violet-300 sm:text-base\"\n                  >\n                    {{ item.product.name }}\n                  </NuxtLink>\n\n                  <p class=\"mt-1 text-xs text-slate-500\">\n                    {{ formatPrice(item.product.price) }} / unité\n                  </p>\n                </div>\n\n                <button\n                  type=\"button\"\n                  class=\"shrink-0 text-xs text-slate-600 transition hover:text-red-400\"\n                  aria-label=\"Supprimer le produit\"\n                  @click=\"cart.removeCompletely(item.product.id)\"\n                >\n                  ✕\n                </button>\n              </div>\n\n              <div class=\"mt-4 flex items-center justify-between gap-3\">\n                <!-- Quantité -->\n                <div\n                  class=\"flex items-center rounded-xl border border-white/10 bg-white/[0.03]\"\n                >\n                  <button\n                    type=\"button\"\n                    class=\"flex h-9 w-9 items-center justify-center text-slate-400 transition hover:text-white\"\n                    @click=\"cart.remove(item.product.id)\"\n                  >\n                    −\n                  </button>\n\n                  <span\n                    class=\"min-w-8 text-center text-sm font-black text-white\"\n                  >\n                    {{ item.quantity }}\n                  </span>\n\n                  <button\n                    type=\"button\"\n                    class=\"flex h-9 w-9 items-center justify-center text-slate-400 transition hover:text-white disabled:cursor-not-allowed disabled:opacity-30\"\n                    :disabled=\"item.quantity >= item.product.stock\"\n                    @click=\"cart.add(item.product.id)\"\n                  >\n                    +\n                  </button>\n                </div>\n\n                <!-- Sous-total -->\n                <strong class=\"text-sm font-black text-white sm:text-base\">\n                  {{\n                    formatPrice(\n                      item.product.price * item.quantity\n                    )\n                  }}\n                </strong>\n              </div>\n            </div>\n          </article>\n        </div>\n\n        <!-- Vider -->\n        <button\n          type=\"button\"\n          class=\"text-xs font-bold text-slate-600 transition hover:text-red-400\"\n          @click=\"cart.clear()\"\n        >\n          Vider le panier\n        </button>\n      </section>\n\n      <!-- Résumé -->\n      <aside\n        class=\"h-fit rounded-3xl border border-white/10 bg-white/[0.035] p-5 lg:sticky lg:top-24\"\n      >\n        <h2 class=\"font-black text-white\">\n          Récapitulatif\n        </h2>\n\n        <div class=\"mt-5 space-y-3 text-sm\">\n          <div class=\"flex justify-between gap-4 text-slate-400\">\n            <span>\n              {{ cart.count }}\n              {{ cart.count > 1 ? 'articles' : 'article' }}\n            </span>\n\n            <span class=\"text-white\">\n              {{ formatPrice(cart.subtotal) }}\n            </span>\n          </div>\n\n          <div class=\"flex justify-between gap-4 text-slate-400\">\n            <span>\n              Retrait en magasin\n            </span>\n\n            <span class=\"font-bold text-emerald-400\">\n              Gratuit\n            </span>\n          </div>\n        </div>\n\n        <div class=\"my-5 h-px bg-white/10\" />\n\n        <div class=\"flex items-end justify-between gap-4\">\n          <span class=\"text-sm font-bold text-slate-400\">\n            Total\n          </span>\n\n          <span class=\"text-2xl font-black text-white\">\n            {{ formatPrice(cart.subtotal) }}\n          </span>\n        </div>\n\n        <NuxtLink\n          to=\"/checkout\"\n          class=\"mt-6 block rounded-2xl bg-violet-500 px-5 py-4 text-center text-sm font-black text-white shadow-lg shadow-violet-500/20 transition hover:bg-violet-400 hover:scale-[1.01] active:scale-[0.98]\"\n        >\n          Choisir le retrait →\n        </NuxtLink>\n\n        <p class=\"mt-3 text-center text-[11px] leading-5 text-slate-600\">\n          Votre commande sera préparée avant votre arrivée.\n        </p>\n      </aside>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\n\nimport { useCartStore } from '~/stores/useCart'\nimport { useCatalogStore } from '~/stores/useCatalog'\nimport { useCurrency } from '~/composables/useCurrency'\n\nconst cart = useCartStore()\nconst catalog = useCatalogStore()\n\nconst { formatPrice } = useCurrency()\n\nconst cartLines = computed(() => {\n  return Object.entries(cart.items)\n    .map(([id, quantity]) => {\n      const product = catalog.products.find(\n        (item) => item.id === id\n      )\n\n      if (!product) {\n        return null\n      }\n\n      return {\n        product,\n        quantity\n      }\n    })\n    .filter(\n      (\n        item\n      ): item is {\n        product: NonNullable<typeof item>['product']\n        quantity: number\n      } => item !== null\n    )\n})\n</script>"],"version":3}